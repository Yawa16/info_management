{
  "name": "hope-inc-erp-database",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform PostgreSQL migration and seed runners for Hope, Inc. ERP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "node db/scripts/migrate.js migrate",
    "db:status": "node db/scripts/migrate.js status",
    "db:reset": "node db/scripts/migrate.js reset",
    "db:seed": "node db/scripts/seed.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  }
}
