# Supabase project URL and public client key (Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only account provisioning; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000

# Private PostgreSQL connection for the migration/seed runner.
# Supabase Dashboard > Connect > Connection string (URI).
# URL-encode special characters in the database password.
DATABASE_URL=

# Supabase hosted database connections require SSL; local PostgreSQL uses false.
DATABASE_SSL=true

# Reset is for local disposable development databases only.
ALLOW_DATABASE_RESET=false
DEV_DATABASE_NAME=hope_erp_dev
DEV_ALLOWED_HOSTS=
ALLOW_TEAM_SEED=false
ALLOW_DEV_SEED=false
ALLOW_AUDIT_TEST=false
ALLOW_TASK5_TEST=false
DEV_SUPABASE_URL=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# Optional local maintenance connection used only by db:reset.
DATABASE_ADMIN_URL=
NODE_ENV=development
