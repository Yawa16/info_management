# Supabase project URL and client key (Supabase Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Supabase Dashboard > Connect > Connection string (URI).
# URL-encode special characters in the database password.
DATABASE_URL=
APP_DATABASE_URL=

# Supabase hosted database connections require SSL.
DATABASE_SSL=true

# Never enable reset for a shared Supabase project.
ALLOW_DATABASE_RESET=false
DEV_DATABASE_NAME=hope_erp_dev
DEV_ALLOWED_HOSTS=
DATABASE_ADMIN_URL=

# Optional; reset recreates the database owned by DATABASE_URL's username.
# Set NODE_ENV=production in production environments.
NODE_ENV=development
