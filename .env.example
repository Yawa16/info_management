# Separate migration connection; do not use this elevated login in application code.
DATABASE_URL=postgresql://hope_migrator:replace_me@localhost:5432/hope_erp_dev

# Least-privilege application login; grant table permissions only as needed.
APP_DATABASE_URL=postgresql://hope_app:replace_me@localhost:5432/hope_erp_dev

# Optional SSL for hosted PostgreSQL (set true for Supabase).
DATABASE_SSL=false

# Reset is disabled unless explicitly enabled. Keep it false for shared databases.
ALLOW_DATABASE_RESET=false
DEV_DATABASE_NAME=hope_erp_dev
DEV_ALLOWED_HOSTS=

# PostgreSQL administrator connection used only by the dev reset command.
DATABASE_ADMIN_URL=postgresql://postgres:replace_me@localhost:5432/postgres

# Optional; reset recreates the database owned by DATABASE_URL's username.
# Set NODE_ENV=production in production environments.
NODE_ENV=development
